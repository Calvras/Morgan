{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morgan",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
